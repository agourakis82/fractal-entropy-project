# === CODEX-FOS configuration ===
# Paths are relative to repository root
MANUSCRIPT_DIR="fos/manuscript/core"
MAIN_TEX="main.tex"
BIB_FILE="references.bib"
FIG_DIR="figures"
# Preferred BibTeX style (falls back to sn-basic if sn-chicago is missing)
BIB_STYLE="sn-chicago"
# Packaging
DIST_DIR="dist"
ZIP_SOURCE="submission_source.zip"
ZIP_WITH_PDF="for_review_with_pdf.zip"
# Optional: generate DOCX via pandoc if available (true/false)
MAKE_DOCX="true"
DOCX_NAME="main.docx"
